        // ==================== APPLICATION STATE ====================
        let threads = [];
        let activeThreadId = null;
        let selectedMessageId = null;
        let editingMessageId = null;
        let pressTimer = null;
        let isLongPressTriggered = false;
        let callTimerInterval = null;
        let pendingAvatarDataUrl = '';
        let lastKnownDateKey = getLocalDateKey(new Date());

        // ==================== INITIALIZATION & LOCALSTORAGE ====================
        function loadData() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    threads = JSON.parse(saved);
                } else {
                    threads = createDefaultThreads();
                    saveData();
                }
            } catch (e) {
                console.error("Storage error:", e);
                threads = createDefaultThreads();
            }
        }

        function saveData() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(threads));
            } catch (e) {
                console.error("Failed to save to localStorage:", e);
            }
        }

        // ==================== AUTOMATIC 12:00 AM MIDNIGHT ROLLOVER ====================
        function startMidnightRolloverWatcher() {
            // Check every 10 seconds if the calendar day rolled over at 12:00 AM
            setInterval(() => {
                const currentKey = getLocalDateKey(new Date());
                if (currentKey !== lastKnownDateKey) {
                    lastKnownDateKey = currentKey;
                    renderInbox();
                    if (activeThreadId) {
                        renderChatMessages();
                    }
                }
            }, 10000);

            // Also re-evaluate immediately when user returns to browser tab / unlocks phone
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) {
                    const currentKey = getLocalDateKey(new Date());
                    if (currentKey !== lastKnownDateKey) {
                        lastKnownDateKey = currentKey;
                    }
                    renderInbox();
                    if (activeThreadId) {
                        renderChatMessages();
                    }
                }
            });
        }

        // ==================== PROCESS CODE-LEVEL INCOMING MESSAGES ====================
        function receiveIncomingMessage(chatIdOrName, messageText, customDateISO = '') {
            if (!messageText || !chatIdOrName) return false;

            let thread = threads.find(
                t => t.id === chatIdOrName || t.sender.toLowerCase() === chatIdOrName.toLowerCase()
            );

            const msgDateISO = customDateISO && !isNaN(new Date(customDateISO).getTime())
                ? new Date(customDateISO).toISOString()
                : new Date().toISOString();

            if (!thread) {
                const initials = chatIdOrName.slice(0, 2).toUpperCase();
                thread = {
                    id: 'thread_' + Date.now(),
                    sender: chatIdOrName,
                    phone: 'iMessage Contact',
                    avatarText: initials,
                    avatarColor: 'bg-gradient-to-br from-blue-500 to-indigo-600',
                    avatarImage: '',
                    unread: true,
                    messages: []
                };
                threads.unshift(thread);
            }

            const incomingMsg = {
                id: 'msg_in_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                text: messageText,
                type: 'received', // Always displays on the LEFT side in gray bubble
                dateISO: msgDateISO
            };

            thread.messages.push(incomingMsg);

            if (activeThreadId !== thread.id) {
                thread.unread = true;
            }

            threads = [thread, ...threads.filter(t => t.id !== thread.id)];
            saveData();
            renderInbox();

            if (activeThreadId === thread.id) {
                renderChatMessages();
                scrollToBottom();
            }
            return true;
        }

        function processCodeIncomingMessages() {
            if (!Array.isArray(INCOMING_MESSAGES_FROM_CODE) || INCOMING_MESSAGES_FROM_CODE.length === 0) return;

            let deliveredIds = [];
            try {
                deliveredIds = JSON.parse(localStorage.getItem(DELIVERED_INCOMING_KEY) || '[]');
            } catch (e) {
                deliveredIds = [];
            }

            let anyDelivered = false;
            INCOMING_MESSAGES_FROM_CODE.forEach(item => {
                if (!item || !item.id || !item.chatId || !item.text) return;
                if (!deliveredIds.includes(item.id)) {
                    const success = receiveIncomingMessage(item.chatId, item.text, item.dateISO || item.time || '');
                    if (success) {
                        deliveredIds.push(item.id);
                        anyDelivered = true;
                    }
                }
            });

            if (anyDelivered) {
                localStorage.setItem(DELIVERED_INCOMING_KEY, JSON.stringify(deliveredIds));
            }
        }

        // Helper to render Avatar (Image if set, otherwise Initials + Gradient)
        function getAvatarHtml(thread) {
            if (thread.avatarImage && thread.avatarImage.trim() !== '') {
                return `<img src="${escapeHtml(thread.avatarImage)}" alt="${escapeHtml(thread.sender)}" class="w-full h-full object-cover" onerror="this.style.display='none'; this.parentElement.textContent='${escapeHtml(thread.avatarText)}';">`;
            }
            return escapeHtml(thread.avatarText);
        }

        // ==================== RENDER INBOX LIST ====================
        function renderInbox() {
            const listEl = document.getElementById('inbox-list');
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            listEl.innerHTML = '';

            const filteredThreads = threads.filter(t => {
                const lastMsg = t.messages.length ? t.messages[t.messages.length - 1].text.toLowerCase() : '';
                return t.sender.toLowerCase().includes(query) || lastMsg.includes(query);
            });

            if (filteredThreads.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-12 px-6 text-gray-400 text-[17px]">
                        No messages found.
                    </div>
                `;
                return;
            }

            filteredThreads.forEach(thread => {
                const lastMsgObj = thread.messages[thread.messages.length - 1];
                const previewText = lastMsgObj ? lastMsgObj.text : 'No messages';
                const timeText = lastMsgObj ? getInboxPreviewTime(parseMessageDate(lastMsgObj)) : '';

                const item = document.createElement('div');
                item.className = 'flex items-center px-3.5 py-3 hover:bg-gray-50 active:bg-gray-100 cursor-pointer transition select-none';
                item.onclick = () => openChat(thread.id);

                item.innerHTML = `
                    <!-- Unread Blue Dot -->
                    <div class="w-4 flex items-center justify-center shrink-0">
                        ${thread.unread ? '<span class="w-3 h-3 rounded-full bg-[#007AFF]"></span>' : ''}
                    </div>

                    <!-- Avatar Circle (Supports Custom Picture or Default Initials) -->
                    <div class="w-[52px] h-[52px] rounded-full ${thread.avatarColor} text-white font-bold text-[18px] flex items-center justify-center shrink-0 mr-3.5 shadow-xs overflow-hidden">
                        ${getAvatarHtml(thread)}
                    </div>

                    <!-- Sender & Snippet -->
                    <div class="flex-1 min-w-0 pr-1">
                        <div class="flex items-center justify-between">
                            <h3 class="text-[18px] font-bold text-black truncate">${escapeHtml(thread.sender)}</h3>
                            <div class="flex items-center text-gray-400 text-[15px] shrink-0 ml-2">
                                <span>${escapeHtml(timeText)}</span>
                                <svg class="w-4 h-4 ml-0.5 text-gray-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                                </svg>
                            </div>
                        </div>
                        <p class="text-[15px] ${thread.unread ? 'text-gray-900 font-medium' : 'text-gray-500'} line-clamp-2 leading-snug mt-0.5">
                            ${escapeHtml(previewText)}
                        </p>
                    </div>
                `;
                listEl.appendChild(item);
            });
        }

        // ==================== OPEN & CLOSE CHAT ====================
        function openChat(threadId) {
            activeThreadId = threadId;
            const thread = threads.find(t => t.id === threadId);
            if (!thread) return;

            if (thread.unread) {
                thread.unread = false;
                saveData();
                renderInbox();
            }

            const avatarEl = document.getElementById('chat-header-avatar');
            avatarEl.className = `w-11 h-11 rounded-full flex items-center justify-center text-white font-bold text-base shadow-sm overflow-hidden relative ${thread.avatarColor}`;
            avatarEl.innerHTML = getAvatarHtml(thread);
            document.getElementById('chat-header-name').textContent = thread.sender;
            document.getElementById('chat-header-subtitle').textContent = thread.phone;

            const unreadCount = threads.filter(t => t.unread).length;
            document.getElementById('unread-badge-back').textContent = unreadCount > 0 ? `Messages (${unreadCount})` : 'Messages';

            cancelEdit();
            renderChatMessages();

            document.getElementById('view-inbox').classList.add('slide-out');
            document.getElementById('view-chat').classList.add('slide-in');

            setTimeout(() => {
                scrollToBottom();
            }, 100);
        }

        function closeChat() {
            cancelEdit();
            document.getElementById('view-inbox').classList.remove('slide-out');
            document.getElementById('view-chat').classList.remove('slide-in');
            activeThreadId = null;
            renderInbox();
        }

        // ==================== RENDER CHAT MESSAGES (SINGLE DAY HEADER + SWIPE-LEFT TIME) ====================
        function renderChatMessages() {
            const container = document.getElementById('chat-messages-area');
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;

            container.innerHTML = '';

            // Top iMessage Info Header inside chat
            const headerInfo = document.createElement('div');
            headerInfo.className = 'text-center py-3 mb-2 border-b border-gray-100';
            headerInfo.innerHTML = `
                <div class="text-[12px] font-semibold text-gray-400 uppercase tracking-wider">iMessage â¢ SMS</div>
                <div class="text-[14px] text-gray-500 mt-0.5">From: <span class="font-semibold text-gray-800">${escapeHtml(thread.sender)}</span> (${escapeHtml(thread.phone)})</div>
            `;
            container.appendChild(headerInfo);

            if (thread.messages.length === 0) {
                container.innerHTML += `
                    <div class="text-center text-gray-400 text-[16px] py-10">
                        All messages in this chat were deleted. Type below to send a new message.
                    </div>
                `;
                return;
            }

            let lastRenderedDateKey = null;

            thread.messages.forEach((msg, index) => {
                const isSent = msg.type === 'sent';
                const msgDateObj = parseMessageDate(msg);
                const currentDateKey = getLocalDateKey(msgDateObj);

                // Show ONE single centered date header ONLY when the calendar day changes
                if (currentDateKey !== lastRenderedDateKey) {
                    lastRenderedDateKey = currentDateKey;
                    const dayDiv = document.createElement('div');
                    dayDiv.className = 'text-center my-3 select-none';
                    dayDiv.innerHTML = `
                        <span class="inline-block text-[13px] font-semibold text-gray-500 bg-gray-100/90 px-3 py-1 rounded-full">
                            ${escapeHtml(getDynamicDayHeader(msgDateObj))}
                        </span>
                    `;
                    container.appendChild(dayDiv);
                }

                // Message Row Wrapper (Slides left to reveal exact time on the right edge)
                const rowWrapper = document.createElement('div');
                rowWrapper.className = 'msg-row-wrapper mb-1.5';

                const slideTrack = document.createElement('div');
                slideTrack.className = `msg-slide-track flex flex-col ${isSent ? 'items-end' : 'items-start'}`;

                // Bubble Element
                const bubble = document.createElement('div');
                bubble.id = `msg-bubble-${msg.id}`;
                bubble.className = `max-w-[80%] px-4 py-3 text-[17px] leading-[1.45] cursor-pointer transition-transform break-words ${isSent ? 'bubble-sent' : 'bubble-received'}`;
                
                let contentHtml = `<span>${escapeHtml(msg.text)}</span>`;
                if (msg.edited) {
                    contentHtml += `<span class="block text-[12px] mt-1 opacity-80 italic text-right">Edited</span>`;
                }
                if (msg.forwarded) {
                    contentHtml = `<span class="block text-[12px] mb-1 opacity-80 italic flex items-center gap-1">âª Forwarded</span>` + contentHtml;
                }
                bubble.innerHTML = contentHtml;

                // Attach Long-Press (Touch & Mouse) Listeners
                attachLongPressEvents(bubble, msg.id);

                slideTrack.appendChild(bubble);

                // Delivered status for last sent message
                if (isSent && index === thread.messages.length - 1) {
                    const statusLabel = document.createElement('span');
                    statusLabel.className = 'text-[12px] text-gray-400 font-semibold mt-1 mr-1';
                    statusLabel.textContent = 'Delivered';
                    slideTrack.appendChild(statusLabel);
                }

                // Hidden Clock Time on Right Edge (Revealed when sliding left)
                const sideTime = document.createElement('span');
                sideTime.className = 'msg-side-time';
                sideTime.textContent = formatClockTime(msgDateObj);
                slideTrack.appendChild(sideTime);

                rowWrapper.appendChild(slideTrack);
                container.appendChild(rowWrapper);
            });
        }

        // ==================== iPHONE SWIPE-LEFT TO REVEAL TIMESTAMPS ====================
        function initSwipeLeftTimestamps() {
            const chatArea = document.getElementById('chat-messages-area');
            let startX = 0;
            let startY = 0;
            let isDragging = false;
            let isHorizontalSwipe = null;
            const MAX_REVEAL_OFFSET = 80; // px to reveal clock time on the right

            function applyTrackOffset(offsetPx, withSpring) {
                const tracks = chatArea.querySelectorAll('.msg-slide-track');
                tracks.forEach(track => {
                    if (withSpring) {
                        track.classList.add('msg-slide-spring');
                    } else {
                        track.classList.remove('msg-slide-spring');
                    }
                    track.style.transform = `translateX(${offsetPx}px)`;
                });
            }

            function onPointerStart(clientX, clientY) {
                startX = clientX;
                startY = clientY;
                isDragging = true;
                isHorizontalSwipe = null;
            }

            function onPointerMove(clientX, clientY) {
                if (!isDragging) return;
                const dx = clientX - startX;
                const dy = clientY - startY;

                if (isHorizontalSwipe === null && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
                    isHorizontalSwipe = Math.abs(dx) > Math.abs(dy);
                }

                if (isHorizontalSwipe) {
                    // Cancel any pending long-press if user starts swiping left
                    clearTimeout(pressTimer);
                    document.querySelectorAll('.bubble-pressing').forEach(el => el.classList.remove('bubble-pressing'));

                    // Only allow dragging to the left (negative dx) up to MAX_REVEAL_OFFSET
                    let clamped = Math.min(0, Math.max(-MAX_REVEAL_OFFSET, dx));
                    applyTrackOffset(clamped, false);
                }
            }

            function onPointerEnd() {
                if (!isDragging) return;
                isDragging = false;
                isHorizontalSwipe = null;
                // Spring smoothly back to 0px when finger/mouse is released
                applyTrackOffset(0, true);
            }

            // Touch events (Mobile)
            chatArea.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) {
                    onPointerStart(e.touches[0].clientX, e.touches[0].clientY);
                }
            }, { passive: true });

            chatArea.addEventListener('touchmove', (e) => {
                if (e.touches.length === 1) {
                    onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
                }
            }, { passive: true });

            chatArea.addEventListener('touchend', onPointerEnd);
            chatArea.addEventListener('touchcancel', onPointerEnd);

            // Mouse drag events (Desktop testing)
            chatArea.addEventListener('mousedown', (e) => {
                if (e.button === 0) {
                    onPointerStart(e.clientX, e.clientY);
                }
            });

            window.addEventListener('mousemove', (e) => {
                if (isDragging) {
                    onPointerMove(e.clientX, e.clientY);
                }
            });

            window.addEventListener('mouseup', () => {
                if (isDragging) {
                    onPointerEnd();
                }
            });
        }

        function scrollToBottom() {
            const container = document.getElementById('chat-messages-area');
            container.scrollTop = container.scrollHeight;
        }

        // ==================== SEND OR UPDATE MESSAGE ====================
        function handleInputKeydown(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                handleSendOrUpdate();
            }
        }

        function autoResizeTextarea(el) {
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 112) + 'px';
        }

        function handleSendOrUpdate() {
            const input = document.getElementById('message-input');
            const text = input.value.trim();
            if (!text || !activeThreadId) return;

            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;

            if (editingMessageId) {
                const msg = thread.messages.find(m => m.id === editingMessageId);
                if (msg) {
                    msg.text = text;
                    msg.edited = true;
                    showToast('Message updated');
                }
                cancelEdit();
            } else {
                const newMsg = {
                    id: 'msg_' + Date.now(),
                    text: text,
                    type: 'sent',
                    dateISO: new Date().toISOString()
                };
                thread.messages.push(newMsg);

                threads = [thread, ...threads.filter(t => t.id !== thread.id)];
            }

            input.value = '';
            input.style.height = 'auto';
            saveData();
            renderChatMessages();
            scrollToBottom();
        }

        // ==================== LONG-PRESS (CLICK & HOLD) LOGIC ====================
        function attachLongPressEvents(element, msgId) {
            const startPress = (e) => {
                if (e.type === 'mousedown' && e.button !== 0) return;
                
                isLongPressTriggered = false;
                element.classList.add('bubble-pressing');

                pressTimer = setTimeout(() => {
                    isLongPressTriggered = true;
                    element.classList.remove('bubble-pressing');
                    if (navigator.vibrate) navigator.vibrate(40);
                    openContextMenu(msgId);
                }, 480);
            };

            const cancelPress = () => {
                clearTimeout(pressTimer);
                element.classList.remove('bubble-pressing');
            };

            element.addEventListener('touchstart', startPress, { passive: true });
            element.addEventListener('touchend', cancelPress);
            element.addEventListener('touchmove', cancelPress);

            element.addEventListener('mousedown', startPress);
            element.addEventListener('mouseup', cancelPress);
            element.addEventListener('mouseleave', cancelPress);

            element.addEventListener('contextmenu', (e) => {
                e.preventDefault();
                openContextMenu(msgId);
            });
        }

        function openContextMenu(msgId) {
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;
            const msg = thread.messages.find(m => m.id === msgId);
            if (!msg) return;

            selectedMessageId = msgId;

            const msgDateObj = parseMessageDate(msg);
            const metaInfo = document.getElementById('context-meta-info');
            const senderLabel = msg.type === 'sent' ? 'You' : thread.sender;
            metaInfo.textContent = `${senderLabel} â¢ ${getDynamicDayHeader(msgDateObj)}, ${formatClockTime(msgDateObj)}`;

            const cloneEl = document.getElementById('context-bubble-clone');
            cloneEl.textContent = msg.text;
            cloneEl.className = `px-4 py-3 text-[17px] leading-[1.45] shadow-2xl break-words bubble-highlighted ${
                msg.type === 'sent' ? 'bubble-sent self-end' : 'bubble-received self-start'
            }`;

            document.getElementById('context-overlay').classList.remove('hidden');
        }

        function closeContextMenu(e) {
            if (e) e.stopPropagation();
            document.getElementById('context-overlay').classList.add('hidden');
        }

        // ==================== CONTEXT MENU ACTIONS: EDIT, FORWARD, SHARE, DELETE ====================
        
        // 1. EDIT ACTION
        function triggerEditAction() {
            closeContextMenu();
            const thread = threads.find(t => t.id === activeThreadId);
            const msg = thread?.messages.find(m => m.id === selectedMessageId);
            if (!msg) return;

            editingMessageId = msg.id;
            const input = document.getElementById('message-input');
            input.value = msg.text;
            autoResizeTextarea(input);
            input.focus();

            document.getElementById('edit-banner').classList.remove('hidden');
            document.getElementById('send-btn').classList.replace('bg-[#007AFF]', 'bg-emerald-500');
            document.getElementById('send-icon').innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>`;
        }

        function cancelEdit() {
            editingMessageId = null;
            const input = document.getElementById('message-input');
            input.value = '';
            input.style.height = 'auto';
            document.getElementById('edit-banner').classList.add('hidden');
            const btn = document.getElementById('send-btn');
            btn.classList.remove('bg-emerald-500');
            btn.classList.add('bg-[#007AFF]');
            document.getElementById('send-icon').innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18"/>`;
        }

        // 2. DELETE ACTION
        function triggerDeleteAction() {
            closeContextMenu();
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread || !selectedMessageId) return;

            thread.messages = thread.messages.filter(m => m.id !== selectedMessageId);

            saveData();
            renderChatMessages();
            showToast('Message permanently deleted');
        }

        // 3. SHARE ACTION
        async function triggerShareAction() {
            closeContextMenu();
            const thread = threads.find(t => t.id === activeThreadId);
            const msg = thread?.messages.find(m => m.id === selectedMessageId);
            if (!msg) return;

            const msgDateObj = parseMessageDate(msg);
            const shareText = `${msg.text}\nâ ${thread.sender} (${getDynamicDayHeader(msgDateObj)}, ${formatClockTime(msgDateObj)})`;

            if (navigator.share) {
                try {
                    await navigator.share({
                        title: 'iMessage',
                        text: shareText
                    });
                } catch (err) {
                    // User cancelled share
                }
            } else {
                const tempInput = document.createElement('textarea');
                tempInput.value = shareText;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                showToast('Message copied to clipboard!');
            }
        }

        // 4. FORWARD ACTION
        function triggerForwardAction() {
            closeContextMenu();
            const thread = threads.find(t => t.id === activeThreadId);
            const msg = thread?.messages.find(m => m.id === selectedMessageId);
            if (!msg) return;

            document.getElementById('forward-preview-text').textContent = msg.text;
            const listEl = document.getElementById('forward-contacts-list');
            listEl.innerHTML = '';

            threads.forEach(targetThread => {
                const row = document.createElement('button');
                row.className = 'w-full flex items-center justify-between px-3.5 py-3 hover:bg-gray-50 active:bg-blue-50 rounded-xl transition text-left';
                row.onclick = () => executeForwardTo(targetThread.id, msg.text);

                row.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="w-11 h-11 rounded-full ${targetThread.avatarColor} text-white font-bold text-[15px] flex items-center justify-center overflow-hidden">
                            ${getAvatarHtml(targetThread)}
                        </div>
                        <div>
                            <div class="text-[17px] font-bold text-gray-900">${escapeHtml(targetThread.sender)}</div>
                            <div class="text-[14px] text-gray-400">${escapeHtml(targetThread.phone)}</div>
                        </div>
                    </div>
                    <span class="text-[15px] font-semibold text-[#007AFF] bg-blue-50 px-3.5 py-1.5 rounded-full">Send</span>
                `;
                listEl.appendChild(row);
            });

            document.getElementById('forward-modal').classList.remove('hidden');
        }

        function executeForwardTo(targetThreadId, textToForward) {
            const targetThread = threads.find(t => t.id === targetThreadId);
            if (!targetThread) return;

            targetThread.messages.push({
                id: 'msg_' + Date.now(),
                text: textToForward,
                type: 'sent',
                forwarded: true,
                dateISO: new Date().toISOString()
            });

            threads = [targetThread, ...threads.filter(t => t.id !== targetThread.id)];
            saveData();
            closeForwardModal();

            if (targetThreadId === activeThreadId) {
                renderChatMessages();
                scrollToBottom();
            }
            showToast(`Forwarded to ${targetThread.sender}`);
        }

        function closeForwardModal(e) {
            if (e) e.stopPropagation();
            document.getElementById('forward-modal').classList.add('hidden');
        }

        // ==================== NEW CHAT & RESET MODALS ====================
        function openNewChatModal() {
            document.getElementById('new-contact-name').value = '';
            document.getElementById('new-contact-msg').value = '';
            document.getElementById('new-chat-modal').classList.remove('hidden');
        }

        function closeNewChatModal(e) {
            if (e) e.stopPropagation();
            document.getElementById('new-chat-modal').classList.add('hidden');
        }

        function createNewThread() {
            const name = document.getElementById('new-contact-name').value.trim();
            const msgText = document.getElementById('new-contact-msg').value.trim();

            if (!name || !msgText) {
                showToast('Please enter both recipient and message');
                return;
            }

            const colors = [
                'bg-gradient-to-br from-blue-500 to-indigo-600',
                'bg-gradient-to-br from-emerald-500 to-teal-700',
                'bg-gradient-to-br from-purple-500 to-pink-600',
                'bg-gradient-to-br from-amber-500 to-orange-600'
            ];
            const randomColor = colors[Math.floor(Math.random() * colors.length)];
            const initials = name.slice(0, 2).toUpperCase();

            const newThread = {
                id: 'thread_' + Date.now(),
                sender: name,
                phone: 'iMessage Contact',
                avatarText: initials,
                avatarColor: randomColor,
                avatarImage: '',
                unread: false,
                messages: [
                    {
                        id: 'msg_' + Date.now(),
                        text: msgText,
                        type: 'sent',
                        dateISO: new Date().toISOString()
                    }
                ]
            };

            threads.unshift(newThread);
            saveData();
            closeNewChatModal();
            renderInbox();
            openChat(newThread.id);
        }

        function openResetModal() {
            document.getElementById('reset-modal').classList.remove('hidden');
        }

        function closeResetModal(e) {
            if (e) e.stopPropagation();
            document.getElementById('reset-modal').classList.add('hidden');
        }

        function confirmResetData() {
            threads = createDefaultThreads();
            localStorage.removeItem(DELIVERED_INCOMING_KEY);
            processCodeIncomingMessages();
            saveData();
            renderInbox();
            closeResetModal();
            showToast('All 10 default messages restored');
        }

        // ==================== iPHONE CALL SCREEN FUNCTIONS ====================
        function startCall() {
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;

            const callAvatar = document.getElementById('call-avatar');
            callAvatar.className = `w-24 h-24 rounded-full flex items-center justify-center text-3xl font-bold shadow-2xl mb-4 overflow-hidden border-2 border-white/20 ${thread.avatarColor}`;
            callAvatar.innerHTML = getAvatarHtml(thread);

            document.getElementById('call-name').textContent = thread.sender;
            document.getElementById('call-phone').textContent = thread.phone;
            const statusEl = document.getElementById('call-status');
            statusEl.textContent = 'calling...';
            statusEl.classList.add('animate-pulse');

            document.getElementById('call-screen').classList.remove('hidden');

            let seconds = 0;
            clearInterval(callTimerInterval);
            setTimeout(() => {
                if (document.getElementById('call-screen').classList.contains('hidden')) return;
                statusEl.classList.remove('animate-pulse');
                callTimerInterval = setInterval(() => {
                    seconds++;
                    const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
                    const secs = String(seconds % 60).padStart(2, '0');
                    statusEl.textContent = `${mins}:${secs}`;
                }, 1000);
            }, 2500);
        }

        function endCall() {
            clearInterval(callTimerInterval);
            document.getElementById('call-screen').classList.add('hidden');
            showToast('Call ended');
        }

        function toggleCallBtn(btn) {
            const circle = btn.querySelector('div');
            circle.classList.toggle('bg-white');
            circle.classList.toggle('text-black');
            circle.classList.toggle('bg-white/15');
        }

        // ==================== CUSTOM AVATAR / PICTURE MODAL ====================
        function openAvatarModal() {
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;

            pendingAvatarDataUrl = thread.avatarImage || '';
            document.getElementById('avatar-modal-sender').textContent = thread.sender;
            document.getElementById('avatar-modal-phone').textContent = thread.phone;
            document.getElementById('avatar-url-input').value = thread.avatarImage && !thread.avatarImage.startsWith('data:') ? thread.avatarImage : '';
            document.getElementById('avatar-file-input').value = '';
            document.getElementById('avatar-modal').classList.remove('hidden');
        }

        function closeAvatarModal(e) {
            if (e) e.stopPropagation();
            document.getElementById('avatar-modal').classList.add('hidden');
        }

        function handleAvatarFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                pendingAvatarDataUrl = e.target.result;
                document.getElementById('avatar-url-input').value = '';
                showToast('Photo selected â tap "Save Changes"');
            };
            reader.readAsDataURL(file);
        }

        function saveAvatarImage() {
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;

            const urlVal = document.getElementById('avatar-url-input').value.trim();
            if (urlVal) {
                thread.avatarImage = urlVal;
            } else if (pendingAvatarDataUrl) {
                thread.avatarImage = pendingAvatarDataUrl;
            }

            saveData();
            renderInbox();
            openChat(thread.id);
            closeAvatarModal();
            showToast('Profile photo updated!');
        }

        function removeCustomAvatar() {
            const thread = threads.find(t => t.id === activeThreadId);
            if (!thread) return;

            thread.avatarImage = '';
            pendingAvatarDataUrl = '';
            saveData();
            renderInbox();
            openChat(thread.id);
            closeAvatarModal();
            showToast('Default icon restored');
        }

        // ==================== UTILITIES ====================
        let toastTimeout = null;
        function showToast(message) {
            const toast = document.getElementById('ios-toast');
            toast.textContent = message;
            toast.classList.remove('hidden');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 2400);
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // ==================== STARTUP ====================
        window.onload = function() {
            loadData();
            processCodeIncomingMessages();
            renderInbox();
            initSwipeLeftTimestamps();
            startMidnightRolloverWatcher();
        };
    </script>
