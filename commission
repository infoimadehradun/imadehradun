<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>iPhone Messages - iMessage UI</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
            user-select: none; /* Prevent unwanted text selection during long press */
        }

        input, textarea {
            user-select: text;
        }

        /* Custom Scrollbar for smooth iOS feel */
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.45);
            border-radius: 10px;
        }

        /* iPhone Frame & Screen Transitions */
        .screen-container {
            position: relative;
            overflow: hidden;
        }

        .view-panel {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            transition: transform 0.35s cubic-bezier(0.28, 0.84, 0.42, 1);
            background-color: #ffffff;
        }

        .view-inbox {
            transform: translateX(0);
            z-index: 10;
        }

        .view-inbox.slide-out {
            transform: translateX(-30%);
            filter: brightness(0.92);
        }

        .view-chat {
            transform: translateX(100%);
            z-index: 20;
            box-shadow: -5px 0 25px rgba(0,0,0,0.12);
        }

        .view-chat.slide-in {
            transform: translateX(0);
        }

        /* iMessage Tail Styling */
        .bubble-sent {
            background: linear-gradient(180deg, #2596ff 0%, #007AFF 100%);
            color: white;
            border-radius: 22px 22px 4px 22px;
            position: relative;
        }

        .bubble-received {
            background-color: #E9E9EB;
            color: #000000;
            border-radius: 22px 22px 22px 4px;
            position: relative;
        }

        /* Long Press Active Animation */
        .bubble-pressing {
            transform: scale(0.96);
            transition: transform 0.18s ease;
        }

        .bubble-highlighted {
            transform: scale(1.03);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
            z-index: 60 !important;
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* Context Menu Pop Animation */
        @keyframes popMenu {
            0% {
                opacity: 0;
                transform: scale(0.85);
            }
            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .context-menu-animate {
            animation: popMenu 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Glassmorphism Header & Footer */
        .ios-blur {
            background: rgba(249, 249, 249, 0.90);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        /* iOS Swipe-Left to Reveal Individual Message Time */
        .msg-row-wrapper {
            position: relative;
            width: 100%;
            overflow: visible;
        }

        .msg-slide-track {
            display: flex;
            flex-direction: column;
            width: 100%;
            will-change: transform;
        }

        .msg-slide-spring {
            transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .msg-side-time {
            position: absolute;
            right: -76px;
            top: 50%;
            transform: translateY(-50%);
            width: 68px;
            text-align: right;
            font-size: 13px;
            font-weight: 500;
            color: #8E8E93;
            pointer-events: none;
            white-space: nowrap;
        }
    </style>
</head>
<body class="bg-slate-200 min-h-screen flex items-center justify-center p-0 sm:p-4">

    <!-- Main iPhone Outer Chassis (Full screen on mobile, iPhone frame on desktop) -->
    <div class="w-full h-[100dvh] sm:w-[420px] sm:h-[850px] bg-black sm:rounded-[54px] sm:p-[12px] sm:shadow-2xl relative flex flex-col overflow-hidden border-0 sm:border-[3px] sm:border-gray-800">
        
        <!-- Inner Screen (No Top Status Bar: No Time, Battery, Wi-Fi, or Signal icons) -->
        <div class="w-full h-full bg-white sm:rounded-[42px] overflow-hidden flex flex-col relative">
            
            <!-- Screen Container (Holds Inbox View & Chat View) -->
            <div class="screen-container flex-1 w-full relative">
                
                <!-- ==================== 1. INBOX / MESSAGES LIST VIEW ==================== -->
                <div id="view-inbox" class="view-panel view-inbox flex flex-col">
                    <!-- Top Bar -->
                    <div class="px-4 pt-4 pb-3 ios-blur border-b border-gray-200/80 z-10">
                        <div class="flex items-center justify-between mb-1">
                            <button onclick="openResetModal()" class="text-[#007AFF] text-[17px] font-medium active:opacity-50">
                                Reset
                            </button>
                            <button onclick="openNewChatModal()" class="text-[#007AFF] p-1 active:opacity-50" title="New Message">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                                </svg>
                            </button>
                        </div>
                        <h1 class="text-[36px] font-bold tracking-tight text-black leading-tight">Messages</h1>
                        
                        <!-- Search Bar -->
                        <div class="mt-2.5 relative">
                            <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-gray-400">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                                </svg>
                            </div>
                            <input type="text" id="search-input" oninput="renderInbox()" placeholder="Search" 
                                class="w-full bg-[#767680]/15 text-black placeholder-gray-500 text-[17px] rounded-xl pl-10 pr-4 py-2 focus:outline-none focus:bg-[#767680]/20 transition">
                        </div>
                    </div>

                    <!-- Conversations List (10+ Threads) -->
                    <div id="inbox-list" class="flex-1 overflow-y-auto divide-y divide-gray-100 pb-6">
                        <!-- Dynamically populated by JS -->
                    </div>
                </div>

                <!-- ==================== 2. CONVERSATION / CHAT VIEW ==================== -->
                <div id="view-chat" class="view-panel view-chat flex flex-col bg-white">
                    
                    <!-- Chat Top Navigation Bar (Dead-Centered Sender Name + Call Button) -->
                    <div class="ios-blur border-b border-gray-200/80 px-2.5 pt-3.5 pb-2.5 grid grid-cols-3 items-center z-20 shrink-0">
                        <!-- Left: Back Button -->
                        <div class="flex items-center justify-start">
                            <button onclick="closeChat()" class="flex items-center text-[#007AFF] px-1 py-1 rounded-lg active:opacity-50">
                                <svg class="w-7 h-7 -ml-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
                                </svg>
                                <span id="unread-badge-back" class="text-[17px] font-medium ml-0.5 truncate">Messages</span>
                            </button>
                        </div>

                        <!-- Center: Sender Avatar & Name (Dead Center) -->
                        <div class="flex flex-col items-center justify-center cursor-pointer group" onclick="openAvatarModal()" title="Change Photo or View Info">
                            <div id="chat-header-avatar" class="w-11 h-11 rounded-full flex items-center justify-center text-white font-bold text-base shadow-sm overflow-hidden relative">
                                M
                            </div>
                            <div class="flex items-center justify-center space-x-0.5 mt-1 max-w-full">
                                <span id="chat-header-name" class="text-[17px] font-bold text-black truncate max-w-[140px] text-center leading-tight">Sender Name</span>
                                <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                                </svg>
                            </div>
                            <span id="chat-header-subtitle" class="text-[12px] text-gray-500 font-medium truncate max-w-[140px]">iMessage</span>
                        </div>

                        <!-- Right: Call Button -->
                        <div class="flex items-center justify-end pr-1">
                            <button onclick="startCall()" class="flex items-center space-x-1.5 text-[#007AFF] bg-blue-50 hover:bg-blue-100 px-3.5 py-2 rounded-full active:scale-95 transition" title="Call">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.07 21 3 13.93 3 5a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.24 1.01l-2.21 2.2z"/>
                                </svg>
                                <span class="text-[15px] font-semibold">Call</span>
                            </button>
                        </div>
                    </div>

                    <!-- Editing Indicator Banner (Shown when editing a message) -->
                    <div id="edit-banner" class="hidden bg-blue-50 border-b border-blue-200 px-4 py-2.5 flex items-center justify-between text-[15px] text-blue-700 z-10">
                        <div class="flex items-center space-x-2">
                            <svg class="w-5 h-5 text-[#007AFF]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487z"/>
                            </svg>
                            <span class="font-semibold">Editing message...</span>
                        </div>
                        <button onclick="cancelEdit()" class="text-red-600 font-semibold px-2.5 py-1 rounded hover:bg-red-100">Cancel</button>
                    </div>

                    <!-- Messages Scroll Area (Swipe left to reveal individual message times) -->
                    <div id="chat-messages-area" class="flex-1 overflow-y-auto overflow-x-hidden px-4 py-3.5 space-y-1.5 bg-white">
                        <!-- Dynamically populated by JS -->
                    </div>

                    <!-- Bottom Message Input Bar -->
                    <div class="ios-blur border-t border-gray-200/80 px-3.5 py-3 flex items-end space-x-2.5 shrink-0 z-20">
                        <button onclick="showToast('Camera & Photos coming soon')" class="w-9 h-9 rounded-full bg-gray-200/80 text-gray-600 flex items-center justify-center shrink-0 mb-0.5 active:scale-95 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                            </svg>
                        </button>

                        <div class="flex-1 bg-white border border-gray-300 rounded-2xl px-4 py-2 flex items-center shadow-2xs focus-within:border-[#007AFF] transition">
                            <textarea id="message-input" rows="1" placeholder="iMessage" 
                                oninput="autoResizeTextarea(this)"
                                onkeydown="handleInputKeydown(event)"
                                class="w-full text-[17px] text-black placeholder-gray-400 focus:outline-none resize-none max-h-28 leading-snug bg-transparent"></textarea>
                        </div>

                        <button id="send-btn" onclick="handleSendOrUpdate()" class="w-9 h-9 rounded-full bg-[#007AFF] text-white flex items-center justify-center shrink-0 mb-0.5 shadow-sm active:scale-90 transition">
                            <svg id="send-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18"/>
                            </svg>
                        </button>
                    </div>
                </div>

            </div>

            <!-- Home Indicator Bar (Bottom iPhone Bar) -->
            <div class="h-5 bg-white flex items-center justify-center shrink-0 z-40">
                <div class="w-36 h-1 bg-black/80 rounded-full"></div>
            </div>

            <!-- ==================== 3. LONG-PRESS CONTEXT MENU OVERLAY ==================== -->
            <div id="context-overlay" class="hidden absolute inset-0 z-50 bg-black/40 backdrop-blur-md flex flex-col justify-center items-center p-5 transition-opacity" onclick="closeContextMenu(event)">
                
                <!-- Preview of Selected Message -->
                <div id="context-preview-container" class="w-full max-w-[340px] mb-3.5 flex flex-col" onclick="event.stopPropagation()">
                    <div id="context-meta-info" class="text-[13px] text-white/95 font-medium mb-1.5 px-1 drop-shadow">
                        <!-- Sender & Time info -->
                    </div>
                    <div id="context-bubble-clone" class="px-4 py-3 text-[17px] leading-[1.45] shadow-2xl break-words">
                        <!-- Selected message text -->
                    </div>
                </div>

                <!-- iPhone Style Action Menu -->
                <div id="context-menu-box" class="w-64 bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl overflow-hidden divide-y divide-gray-200/80 context-menu-animate" onclick="event.stopPropagation()">
                    
                    <!-- Edit Option -->
                    <button onclick="triggerEditAction()" class="w-full px-4 py-3.5 flex items-center justify-between text-left text-[18px] text-gray-900 hover:bg-gray-100 active:bg-gray-200 transition">
                        <span>Edit</span>
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
                        </svg>
                    </button>

                    <!-- Forward Option -->
                    <button onclick="triggerForwardAction()" class="w-full px-4 py-3.5 flex items-center justify-between text-left text-[18px] text-gray-900 hover:bg-gray-100 active:bg-gray-200 transition">
                        <span>Forward</span>
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 000 12h3"/>
                        </svg>
                    </button>

                    <!-- Share Option -->
                    <button onclick="triggerShareAction()" class="w-full px-4 py-3.5 flex items-center justify-between text-left text-[18px] text-gray-900 hover:bg-gray-100 active:bg-gray-200 transition">
                        <span>Share</span>
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/>
                        </svg>
                    </button>

                    <!-- Delete Option -->
                    <button onclick="triggerDeleteAction()" class="w-full px-4 py-3.5 flex items-center justify-between text-left text-[18px] text-red-600 font-medium hover:bg-red-50 active:bg-red-100 transition">
                        <span>Delete</span>
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- ==================== 4. FORWARD MODAL SHEET ==================== -->
            <div id="forward-modal" class="hidden absolute inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-end justify-center" onclick="closeForwardModal(event)">
                <div class="w-full bg-white rounded-t-3xl max-h-[82%] flex flex-col shadow-2xl overflow-hidden" onclick="event.stopPropagation()">
                    <div class="px-4 py-4 border-b border-gray-200 flex items-center justify-between bg-gray-50">
                        <button onclick="closeForwardModal()" class="text-[#007AFF] text-[17px] font-medium">Cancel</button>
                        <span class="font-bold text-[18px] text-black">Forward to...</span>
                        <div class="w-14"></div>
                    </div>
                    <div class="p-3.5 bg-blue-50/70 border-b border-blue-100 text-[15px] text-gray-700">
                        <span class="font-semibold text-[#007AFF]">Message:</span>
                        <p id="forward-preview-text" class="truncate mt-0.5 text-gray-800"></p>
                    </div>
                    <div id="forward-contacts-list" class="flex-1 overflow-y-auto divide-y divide-gray-100 p-2">
                        <!-- Contacts populated dynamically -->
                    </div>
                </div>
            </div>

            <!-- ==================== 5. NEW MESSAGE MODAL ==================== -->
            <div id="new-chat-modal" class="hidden absolute inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-end justify-center" onclick="closeNewChatModal(event)">
                <div class="w-full bg-white rounded-t-3xl p-5 flex flex-col shadow-2xl space-y-4" onclick="event.stopPropagation()">
                    <div class="flex items-center justify-between border-b border-gray-100 pb-3.5">
                        <button onclick="closeNewChatModal()" class="text-[#007AFF] text-[17px] font-medium">Cancel</button>
                        <span class="font-bold text-[18px] text-black">New iMessage</span>
                        <button onclick="createNewThread()" class="text-[#007AFF] font-bold text-[17px]">Send</button>
                    </div>
                    <div>
                        <label class="text-[14px] font-semibold text-gray-600">To (Sender Name or Number)</label>
                        <input type="text" id="new-contact-name" placeholder="e.g. Alex Johnson or +1 555-0192" class="w-full mt-1.5 border border-gray-300 rounded-xl px-3.5 py-2.5 text-[17px] focus:outline-none focus:border-[#007AFF]">
                    </div>
                    <div>
                        <label class="text-[14px] font-semibold text-gray-600">Message</label>
                        <textarea id="new-contact-msg" rows="3" placeholder="Type your message here..." class="w-full mt-1.5 border border-gray-300 rounded-xl px-3.5 py-2.5 text-[17px] focus:outline-none focus:border-[#007AFF]"></textarea>
                    </div>
                </div>
            </div>

            <!-- ==================== 6. RESET CONFIRMATION SHEET ==================== -->
            <div id="reset-modal" class="hidden absolute inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-end justify-center p-3" onclick="closeResetModal(event)">
                <div class="w-full space-y-2.5" onclick="event.stopPropagation()">
                    <div class="bg-white/95 backdrop-blur-xl rounded-2xl overflow-hidden text-center divide-y divide-gray-200">
                        <div class="p-4">
                            <p class="text-[15px] text-gray-600">Are you sure you want to restore all 10 default conversations? Your current edits will be reset.</p>
                        </div>
                        <button onclick="confirmResetData()" class="w-full py-4 text-red-600 font-semibold text-[18px] active:bg-gray-100">
                            Reset All Messages
                        </button>
                    </div>
                    <button onclick="closeResetModal()" class="w-full py-4 bg-white rounded-2xl text-[#007AFF] font-semibold text-[18px] shadow-lg active:bg-gray-100">
                        Cancel
                    </button>
                </div>
            </div>

            <!-- ==================== 7. iPHONE CALLING OVERLAY SCREEN ==================== -->
            <div id="call-screen" class="hidden absolute inset-0 z-[65] bg-gradient-to-b from-slate-900 via-gray-900 to-black text-white flex flex-col justify-between py-12 px-6">
                <!-- Top Caller Info -->
                <div class="flex flex-col items-center text-center mt-4">
                    <div id="call-avatar" class="w-24 h-24 rounded-full flex items-center justify-center text-3xl font-bold shadow-2xl mb-4 overflow-hidden border-2 border-white/20">
                        M
                    </div>
                    <h2 id="call-name" class="text-[26px] font-bold tracking-tight">Sender Name</h2>
                    <p id="call-phone" class="text-[16px] text-gray-400 mt-1">+1 (555) 234-5678</p>
                    <p id="call-status" class="text-[16px] text-emerald-400 font-medium mt-2 animate-pulse">calling...</p>
                </div>

                <!-- Middle iPhone Call Controls -->
                <div class="grid grid-cols-3 gap-5 max-w-[290px] mx-auto my-auto">
                    <button onclick="toggleCallBtn(this)" class="flex flex-col items-center space-y-2 group">
                        <div class="w-16 h-16 rounded-full bg-white/15 group-active:bg-white/30 flex items-center justify-center transition">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z"/>
                            </svg>
                        </div>
                        <span class="text-[14px] text-gray-300">Mute</span>
                    </button>

                    <button onclick="toggleCallBtn(this)" class="flex flex-col items-center space-y-2 group">
                        <div class="w-16 h-16 rounded-full bg-white/15 group-active:bg-white/30 flex items-center justify-center transition">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
