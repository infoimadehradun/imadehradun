        // ==================== DATE & RELATIVE DAY HELPERS ====================
        // Builds a local ISO string offset by `daysOffset` from today at `hour:minute`
        function buildRelativeISO(daysOffset, hour, minute) {
            const d = new Date();
            d.setDate(d.getDate() + daysOffset);
            d.setHours(hour, minute, 0, 0);
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            const hh = String(d.getHours()).padStart(2, '0');
            const min = String(d.getMinutes()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}T${hh}:${min}:00`;
        }

        function getLocalDateKey(dateObj) {
            const yyyy = dateObj.getFullYear();
            const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
            const dd = String(dateObj.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        }

        function parseMessageDate(msg) {
            if (msg.dateISO) {
                const parsed = new Date(msg.dateISO);
                if (!isNaN(parsed.getTime())) return parsed;
            }
            return new Date();
        }

        // Returns 'Today', 'Yesterday', or formatted calendar date (e.g., 'Nov 24, 2026')
        function getDynamicDayHeader(dateObj) {
            const now = new Date();
            const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const msgMidnight = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate());
            const diffDays = Math.round((todayMidnight - msgMidnight) / (1000 * 60 * 60 * 24));

            if (diffDays === 0) return 'Today';
            if (diffDays === 1) return 'Yesterday';

            return dateObj.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });
        }

        // Returns clean 12-hour clock time (e.g., '10:23 AM')
        function formatClockTime(dateObj) {
            let hours = dateObj.getHours();
            let minutes = dateObj.getMinutes();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12;
            minutes = minutes < 10 ? '0' + minutes : minutes;
            return `${hours}:${minutes} ${ampm}`;
        }

